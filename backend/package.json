{
  "name": "@remitmortgage/backend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc && sentry-cli sourcemaps inject dist && sentry-cli sourcemaps upload dist",
    "start": "node dist/index.js",
    "lint": "eslint src/",
    "docs:export": "tsx src/docs/export-openapi.ts",
    "test": "jest",
    "test:coverage": "jest --coverage",
    "test:integration": "jest --testPathPattern='prismaSchemaDrift' --no-coverage",
    "test:drift": "jest src/__tests__/prismaSchemaDrift.test.ts --no-coverage",
    "drift:check": "bash ./scripts/detect-prisma-drift.sh",
    "drift:check:ci": "bash ./scripts/detect-prisma-drift.sh --exit-code",
    "drift:sync": "bash ./scripts/sync-production-schema.sh --from-schema=prisma/schema.prisma",
    "db:migrate": "prisma migrate dev",
    "db:seed": "tsx prisma/seed.ts",
    "anonymize:staging-seed": "tsx scripts/anonymize-staging-seed.ts",
    "load-test": "tsx load-tests/run-all.ts",
    "load-test:health": "tsx load-tests/scenarios/health-read.ts",
    "load-test:audit": "tsx load-tests/scenarios/audit-log-read.ts",
    "load-test:analytics": "tsx load-tests/scenarios/analytics-read.ts",
    "load-test:loans": "tsx load-tests/scenarios/loan-status-read.ts",
    "load-test:verify": "tsx load-tests/scenarios/verification-write.ts",
    "load-test:mixed": "tsx load-tests/scenarios/mixed-workload.ts",
    "load-test:month-end": "tsx load-tests/scenarios/month-end-payment-spike.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.709.0",
    "@aws-sdk/client-secrets-manager": "^3.1127.0",
    "@google-cloud/storage": "^7.15.0",
    "@irys/sdk": "^0.2.11",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/auto-instrumentations-node": "^0.79.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.221.0",
    "@opentelemetry/resources": "^2.10.0",
    "@opentelemetry/sdk-node": "^0.221.0",
    "@opentelemetry/sdk-trace-node": "^2.10.0",
    "@opentelemetry/semantic-conventions": "^1.43.0",
    "@prisma/client": "^7.8.0",
    "@sentry/node": "^10.68.0",
    "@stellar/stellar-sdk": "^13.1.0",
    "@types/ioredis": "^4.28.10",
    "axios": "^1.7.9",
    "bs58": "^6.0.0",
    "bullmq": "^5.81.2",
    "cls-rtracer": "^2.6.4",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "ethers": "^6.17.0",
    "express": "^5.1.0",
    "express-rate-limit": "^6.10.0",
    "helmet": "~8.2.0",
    "ioredis": "^5.11.1",
    "jsonwebtoken": "^9.0.3",
    "multer": "^1.4.5-lts.1",
    "node-cron": "^4.5.0",
    "nodemailer": "^9.0.1",
    "pdfkit": "^0.19.1",
    "prom-client": "^15.1.3",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^4.6.3",
    "tweetnacl": "^1.0.3",
    "winston": "^3.19.0"
  },
  "devDependencies": {
    "@sentry/cli": "^3.6.2",
    "@types/bs58": "^4.0.4",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.2",
    "@types/helmet": "~0.0.48",
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.15.3",
    "@types/node-cron": "^3.0.11",
    "@types/nodemailer": "^8.0.1",
    "@types/pdfkit": "^0.17.6",
    "@types/supertest": "^7.2.0",
    "@types/swagger-jsdoc": "^6.0.4",
    "@types/swagger-ui-express": "^4.1.8",
    "autocannon": "^8.0.0",
    "fast-check": "^3.15.0",
    "jest": "^30.4.2",
    "prisma": "^7.8.0",
    "supertest": "^7.2.2",
    "ts-jest": "^29.4.11",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "roots": [
      "<rootDir>/src"
    ],
    "testPathIgnorePatterns": [
      "/node_modules/",
      "/dist/"
    ],
    "moduleNameMapper": {
      "^(\\.{1,2}/.*)\\.js$": "$1"
    },
    "coverageReporters": [
      "text-summary",
      "lcov",
      "cobertura"
    ],
    "coverageThreshold": {
      "global": {
        "statements": 60,
        "branches": 45,
        "functions": 55,
        "lines": 60
      }
    }
  }
}

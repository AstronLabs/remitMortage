# Environment
PORT=4000
# Supported values: testnet | mainnet | futurenet | standalone
STELLAR_NETWORK=testnet
# Optional: override the network passphrase. Defaults to the canonical passphrase
# for the chosen STELLAR_NETWORK when omitted.
# Testnet:    "Test SDF Network ; September 2015"
# Mainnet:    "Public Global Stellar Network ; September 2015"
# Futurenet:  "Test SDF Future Network ; October 2022"
# Standalone: "Standalone Network ; February 2017"
STELLAR_NETWORK_PASSPHRASE=
HORIZON_URL=https://horizon-testnet.stellar.org
# Soroban RPC endpoint used for read-only on-chain contract queries
SOROBAN_RPC_URL=https://soroban-testnet.stellar.org
# Multiple RPC URLs for automatic failover (comma-separated)
# Example: https://rpc1.stellar.org,https://rpc2.stellar.org,https://rpc3.stellar.org
SOROBAN_RPC_URLS=https://soroban-testnet.stellar.org

# Database
DATABASE_URL=postgresql://remituser:remitpass@localhost:5432/remitmortgage
# Optional: dedicated PostgreSQL read replica for analytics/dashboard reads.
# When set, analytics queries prefer this endpoint unless replica lag exceeds the threshold.
DATABASE_REPLICA_URL=
DB_REPLICA_LAG_THRESHOLD_SECONDS=30

# Database connection pool tuning (Prisma built-in pool)
# DB_CONNECTION_LIMIT: max open connections per process (default: 20)
# DB_POOL_TIMEOUT:     seconds to wait for a free connection before P2024 error (default: 15)
# DB_CONNECT_TIMEOUT:  seconds for the initial TCP handshake to pg (default: 30)
# In multi-instance deployments divide your pg max_connections budget by the
# number of running API replicas to set an appropriate DB_CONNECTION_LIMIT.
DB_CONNECTION_LIMIT=20
DB_POOL_TIMEOUT=15
DB_CONNECT_TIMEOUT=30

# CORS Configuration (comma-separated list of allowed origins)
# Default: http://localhost:3000,http://localhost:4000 for local development
# Production example: https://app.remitmortgage.com,https://www.remitmortgage.com
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:4000

# Contract IDs (fill in after deployment)
ESCROW_CONTRACT_ID=
LENDING_POOL_CONTRACT_ID=
USDC_TOKEN_ID=

# Pinata IPFS integration keys
PINATA_API_KEY=
PINATA_SECRET_API_KEY=
# Email SMTP configuration
SMTP_HOST=localhost
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=no-reply@remitmortgage.com

# SendGrid event-driven email alerts
SENDGRID_API_KEY=
SENDGRID_FROM=no-reply@remitmortgage.com
SENDGRID_SECRET_ID=
# Shared secret the email provider bounce/complaint webhook must send (x-webhook-token header or ?token=).
EMAIL_WEBHOOK_SECRET=
# IDs refreshed by the scheduler (comma-separated). Values remain cached during
# a temporary provider outage until the grace window expires.
SECRETS_ROTATION_IDS=
SECRETS_ROTATION_CRON_SCHEDULE="*/5 * * * *"
SECRETS_CACHE_TTL_MS=300000
SECRETS_GRACE_WINDOW_MS=900000
# JSON map of borrower address -> alert recipient email
ALERT_RECIPIENTS={}
ALERT_DEFAULT_RECIPIENT=

# Webhook secret for payload signing (HMAC SHA-256)
WEBHOOK_SECRET=your_super_secret_webhook_signing_key_here
# Optional: notified when a webhook subscription's signing key auto-rotates
# (every 90 days). Rotation still runs on schedule if left unset.
WEBHOOK_ROTATION_NOTIFY_EMAIL=
# Cron schedule for the webhook key rotation sweep. Default: daily at 03:00 UTC.
WEBHOOK_KEY_ROTATION_CRON_SCHEDULE="0 3 * * *"
# Webhook delivery latency SLA (GET /api/admin/webhooks/latency). Endpoints
# whose p95 dispatch-to-delivery latency exceeds the SLA are flagged.
WEBHOOK_LATENCY_SLA_MS=5000
# Default rolling window for the latency report, in minutes.
WEBHOOK_LATENCY_WINDOW_MINUTES=60

# Admin API Key for accessing restricted endpoints like /api/audit-logs
ADMIN_API_KEY=your_secret_admin_key_here

# Redis cache for Horizon remittance analysis
REDIS_URL=redis://localhost:6379
REMITTANCE_CACHE_TTL=300

# Redis Cluster Configuration (for horizontal queue scaling with BullMQ)
# Set REDIS_CLUSTER_ENABLED=true to use multi-node Redis Cluster mode.
# When cluster mode is enabled, REDIS_CLUSTER_NODES is used instead of REDIS_URL.
REDIS_CLUSTER_ENABLED=false
REDIS_CLUSTER_NODES=localhost:6379,localhost:6380,localhost:6381

# Database Backup Configuration
ENABLE_AUTO_BACKUP=true
BACKUP_PROVIDER=aws
BACKUP_BUCKET=remitmortgage-backups
BACKUP_ENCRYPTION_KEY=your_backup_encryption_key_here_32chars
BACKUP_CRON_SCHEDULE="0 2 * * *"

# AWS S3 Configuration (if using AWS as backup provider)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Google Cloud Storage Configuration (if using GCS as backup provider)
GCS_PROJECT_ID=
GCS_KEY_FILE=/path/to/service-account-key.json

# KMS envelope encryption for KYC documents (borrower passports, payroll
# stubs, credit ratings). KMS_KEY_VERSIONS is a JSON map of rotation version
# -> 32-byte hex-encoded key encryption key, e.g. {"v1":"<64 hex chars>"}.
# Rotate by adding a new version and pointing KMS_ACTIVE_KEY_VERSION at it —
# documents already sealed under older versions keep decrypting correctly.
KMS_KEY_VERSIONS=
KMS_ACTIVE_KEY_VERSION=v1
# Signing secret + TTL for temporary IAM-style KYC document decryption tokens
KYC_OPERATOR_SECRET=your_kyc_operator_signing_secret_here
KYC_ACCESS_TOKEN_TTL=300
# Local directory simulating the private KYC document storage bucket
KYC_STORAGE_DIR=
# Optional backup KYC provider. When set, document verification fails over to
# it after KYC_FAILOVER_THRESHOLD consecutive primary failures and alerts go to
# ALERT_WEBHOOK_URL on activation, persistence and recovery.
KYC_BACKUP_PROVIDER_URL=
KYC_BACKUP_PROVIDER_API_KEY=
KYC_FAILOVER_THRESHOLD=3
KYC_PROVIDER_TIMEOUT_MS=10000
KYC_FAILOVER_COOLDOWN_MS=60000
KYC_FAILOVER_ALERT_AFTER_MS=900000
# HMAC key for applicant tax ID hashes (duplicate SSN/tax ID detection).
# Changing it invalidates existing hashes, so set it once per environment.
TAX_ID_HASH_SECRET=your_tax_id_hash_secret_here

# Gas Fee Spike Protection (Circuit Breaker)
# Maximum base fees before transactions are halted
MAX_STELLAR_BASE_FEE=100000
MAX_EVM_BASE_FEE=100000000000
MAX_SOLANA_BASE_FEE=10000

# Distributed tracing (OpenTelemetry -> Jaeger/APM collector).
# Points at the OTLP endpoint provisioned by infrastructure/terraform/apm.
# Tracing is disabled entirely when unset — safe to omit in local dev.
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=remitmortgage-backend
# Fraction of requests traced (0.0 - 1.0). Defaults to 1.0 (trace everything).
OTEL_TRACES_SAMPLER_RATIO=1.0

# Soft-launch gating: when true, registration requires a valid unused invite code
INVITE_CODE_REQUIRED=false

# Session token data retention policy
# Number of days expired session/refresh tokens are kept before auto-purge
SESSION_TOKEN_RETENTION_DAYS=7
SESSION_TOKEN_PURGE_CRON_SCHEDULE="0 4 * * *"

# Application assignment queue (issue #621)
# When true (default), new loan applications are auto-assigned round-robin to
# the least-recently-assigned ACTIVE reviewer. Set to false to disable.
ASSIGNMENT_QUEUE_ENABLED=true

# Slow query logging + weekly digest (issue #583)
# Operations whose duration exceeds this threshold are captured for the digest.
SLOW_QUERY_THRESHOLD_MS=200
# Comma-separated recipients for the weekly slow-query digest email.
SLOW_QUERY_DIGEST_RECIPIENTS=
# Cron cadence for the digest (default: Mondays 09:00 UTC).
SLOW_QUERY_DIGEST_CRON_SCHEDULE="0 9 * * 1"

# Database connection leak detection
# Age (ms) at which a checked-out connection is flagged as a potential leak.
# A connection is "checked out" from the moment a Prisma operation is issued
# until its promise resolves or rejects. The default (30 s) is long enough to
# exclude intentionally slow bulk operations under normal load, yet short
# enough to catch a genuinely stuck connection while the pool still has
# headroom. Set to 0 to disable leak detection entirely (not recommended).
DB_CONNECTION_LEAK_THRESHOLD_MS=30000
# How often (ms) the background sweeper scans for leaked connections.
# Shorter intervals catch leaks sooner; longer intervals reduce overhead in
# very high-throughput environments.
DB_LEAK_SWEEP_INTERVAL_MS=10000
# Set to "false" to disable capturing an originating call stack for each
# checkout. Stack capture costs ~1–5 µs per query on V8; disable only when
# profiling shows it is measurable in your deployment.
DB_LEAK_DETECTION_CAPTURE_STACK=true

# Loan servicing transfers (issue #693)
# How often scheduled transfers past their effective date are applied.
LOAN_SERVICING_TRANSFER_CRON_SCHEDULE="*/15 * * * *"

# API key least-privilege scope audit (issue #772). Weekly report comparing
# each third-party credential's granted provider scope against capability
# usage actually recorded by the backend; flags scopes granted but never
# exercised. See docs/API_KEY_SCOPE_AUDIT.md. Never revokes anything.
API_KEY_SCOPE_AUDIT_CRON_SCHEDULE="0 11 * * 1"
API_KEY_SCOPE_AUDIT_DIGEST_RECIPIENTS=
# Days an integration must be observed before a never-used scope is flagged
# (avoids false positives on a freshly provisioned/discovered integration).
API_KEY_SCOPE_AUDIT_MIN_OBSERVATION_DAYS=30
# Per-integration override of the scopes actually granted to the provisioned
# credential, comma-separated. Leave unset to fall back to the documented
# default-provisioning bundle in services/apiKeyScopeRegistry.ts — update the
# override any time a key is re-provisioned with a different scope.
PINATA_GRANTED_SCOPES=
IPFS_SECONDARY_GRANTED_SCOPES=
SENDGRID_GRANTED_SCOPES=
KYC_BACKUP_GRANTED_SCOPES=
AWS_S3_BACKUP_GRANTED_SCOPES=
GCS_BACKUP_GRANTED_SCOPES=
# Arweave (Irys wallet key) and the ops alert webhook are inventoried but not
# scope-compared — a wallet key is all-or-nothing and an incoming webhook URL
# can only ever post a message, so "least privilege" doesn't apply to either.
ARWEAVE_GRANTED_SCOPES=
ALERT_WEBHOOK_GRANTED_SCOPES=
# ── White-label tenants ──────────────────────────────────────────────────────
# JSON array of tenant branding records. Requests resolve a tenant from the
# X-Tenant-Id header or the Host header; anything else uses the default brand.
# Example:
# TENANT_BRANDING=[{"id":"acme","name":"Acme Homes","legalEntity":"Acme Lending LLC","hosts":["loans.acme.com"],"logoUrl":"https://cdn.acme.com/logo.png","colors":{"header":"#112233","primary":"#ff6600"},"senderDomain":"acme.com","supportEmail":"help@acme.com"}]
TENANT_BRANDING=

# Environment
PORT=4000
# Supported values: testnet | mainnet | futurenet | standalone
STELLAR_NETWORK=testnet
# Optional: override the network passphrase. Defaults to the canonical passphrase
# for the chosen STELLAR_NETWORK when omitted.
# Testnet:    "Test SDF Network ; September 2015"
# Mainnet:    "Public Global Stellar Network ; September 2015"
# Futurenet:  "Test SDF Future Network ; October 2022"
# Standalone: "Standalone Network ; February 2017"
STELLAR_NETWORK_PASSPHRASE=
HORIZON_URL=https://horizon-testnet.stellar.org
# Soroban RPC endpoint used for read-only on-chain contract queries
SOROBAN_RPC_URL=https://soroban-testnet.stellar.org
# Multiple RPC URLs for automatic failover (comma-separated)
# Example: https://rpc1.stellar.org,https://rpc2.stellar.org,https://rpc3.stellar.org
SOROBAN_RPC_URLS=https://soroban-testnet.stellar.org

# Database
DATABASE_URL=postgresql://remituser:remitpass@localhost:5432/remitmortgage
# Optional: dedicated PostgreSQL read replica for analytics/dashboard reads.
# When set, analytics queries prefer this endpoint unless replica lag exceeds the threshold.
DATABASE_REPLICA_URL=
DB_REPLICA_LAG_THRESHOLD_SECONDS=30

# Database connection pool tuning (Prisma built-in pool)
# DB_CONNECTION_LIMIT: max open connections per process (default: 20)
# DB_POOL_TIMEOUT:     seconds to wait for a free connection before P2024 error (default: 15)
# DB_CONNECT_TIMEOUT:  seconds for the initial TCP handshake to pg (default: 30)
# In multi-instance deployments divide your pg max_connections budget by the
# number of running API replicas to set an appropriate DB_CONNECTION_LIMIT.
DB_CONNECTION_LIMIT=20
DB_POOL_TIMEOUT=15
DB_CONNECT_TIMEOUT=30

# CORS Configuration (comma-separated list of allowed origins)
# Default: http://localhost:3000,http://localhost:4000 for local development
# Production example: https://app.remitmortgage.com,https://www.remitmortgage.com
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:4000

# Contract IDs (fill in after deployment)
ESCROW_CONTRACT_ID=
LENDING_POOL_CONTRACT_ID=
USDC_TOKEN_ID=

# Pinata IPFS integration keys
PINATA_API_KEY=
PINATA_SECRET_API_KEY=
# Email SMTP configuration
SMTP_HOST=localhost
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=no-reply@remitmortgage.com

# SendGrid event-driven email alerts
SENDGRID_API_KEY=
SENDGRID_FROM=no-reply@remitmortgage.com
# JSON map of borrower address -> alert recipient email
ALERT_RECIPIENTS={}
ALERT_DEFAULT_RECIPIENT=

# Webhook secret for payload signing (HMAC SHA-256)
WEBHOOK_SECRET=your_super_secret_webhook_signing_key_here
# Optional: notified when a webhook subscription's signing key auto-rotates
# (every 90 days). Rotation still runs on schedule if left unset.
WEBHOOK_ROTATION_NOTIFY_EMAIL=
# Cron schedule for the webhook key rotation sweep. Default: daily at 03:00 UTC.
WEBHOOK_KEY_ROTATION_CRON_SCHEDULE="0 3 * * *"

# Admin API Key for accessing restricted endpoints like /api/audit-logs
ADMIN_API_KEY=your_secret_admin_key_here

# Redis cache for Horizon remittance analysis
REDIS_URL=redis://localhost:6379
REMITTANCE_CACHE_TTL=300

# Redis Cluster Configuration (for horizontal queue scaling with BullMQ)
# Set REDIS_CLUSTER_ENABLED=true to use multi-node Redis Cluster mode.
# When cluster mode is enabled, REDIS_CLUSTER_NODES is used instead of REDIS_URL.
REDIS_CLUSTER_ENABLED=false
REDIS_CLUSTER_NODES=localhost:6379,localhost:6380,localhost:6381

# Database Backup Configuration
ENABLE_AUTO_BACKUP=true
BACKUP_PROVIDER=aws
BACKUP_BUCKET=remitmortgage-backups
BACKUP_ENCRYPTION_KEY=your_backup_encryption_key_here_32chars
BACKUP_CRON_SCHEDULE="0 2 * * *"

# AWS S3 Configuration (if using AWS as backup provider)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Google Cloud Storage Configuration (if using GCS as backup provider)
GCS_PROJECT_ID=
GCS_KEY_FILE=/path/to/service-account-key.json

# KMS envelope encryption for KYC documents (borrower passports, payroll
# stubs, credit ratings). KMS_KEY_VERSIONS is a JSON map of rotation version
# -> 32-byte hex-encoded key encryption key, e.g. {"v1":"<64 hex chars>"}.
# Rotate by adding a new version and pointing KMS_ACTIVE_KEY_VERSION at it —
# documents already sealed under older versions keep decrypting correctly.
KMS_KEY_VERSIONS=
KMS_ACTIVE_KEY_VERSION=v1
# Signing secret + TTL for temporary IAM-style KYC document decryption tokens
KYC_OPERATOR_SECRET=your_kyc_operator_signing_secret_here
KYC_ACCESS_TOKEN_TTL=300
# Local directory simulating the private KYC document storage bucket
KYC_STORAGE_DIR=

# Gas Fee Spike Protection (Circuit Breaker)
# Maximum base fees before transactions are halted
MAX_STELLAR_BASE_FEE=100000
MAX_EVM_BASE_FEE=100000000000
MAX_SOLANA_BASE_FEE=10000

# Distributed tracing (OpenTelemetry -> Jaeger/APM collector).
# Points at the OTLP endpoint provisioned by infrastructure/terraform/apm.
# Tracing is disabled entirely when unset — safe to omit in local dev.
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=remitmortgage-backend
# Fraction of requests traced (0.0 - 1.0). Defaults to 1.0 (trace everything).
OTEL_TRACES_SAMPLER_RATIO=1.0

# Session token data retention policy
# Number of days expired session/refresh tokens are kept before auto-purge
SESSION_TOKEN_RETENTION_DAYS=7
SESSION_TOKEN_PURGE_CRON_SCHEDULE="0 4 * * *"
